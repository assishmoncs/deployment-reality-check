{
  "name": "deployment-reality-check",
  "version": "1.0.0",
  "description": "A deployment preflight CLI that detects production risks, explains platform-specific failures, and suggests safe fixes before you deploy.",
  "keywords": [
    "typescript",
    "cli",
    "developer-tools",
    "devops",
    "deployment",
    "static-analysis",
    "vercel",
    "railway",
    "nextjs",
    "nodejs",
    "production-readiness",
    "open-source"
  ],
  "homepage": "https://github.com/deployment-reality-check/deployment-reality-check#readme",
  "bugs": {
    "url": "https://github.com/deployment-reality-check/deployment-reality-check/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deployment-reality-check/deployment-reality-check.git"
  },
  "license": "MIT",
  "author": "Deployment Reality Check Contributors",
  "bin": {
    "drc": "./bin/run.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "oclif": {
    "bin": "drc",
    "dirname": "drc",
    "commands": "./dist/commands",
    "description": "Catch deployment problems before production catches you.",
    "topicSeparator": " "
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "typecheck": "node scripts/typecheck.cjs",
    "lint": "node scripts/lint.cjs",
    "format": "node scripts/format.cjs --write",
    "format:check": "node scripts/format.cjs --check",
    "test": "node scripts/test.cjs",
    "test:coverage": "node scripts/coverage.cjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^5.0.0",
    "@oclif/core": "^3.26.0",
    "chalk": "^5.3.0",
    "diff": "^5.2.0",
    "handlebars": "^4.7.8",
    "typescript": "^5.5.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/diff": "^5.0.9",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "vitest": "^1.6.0"
  }
}
