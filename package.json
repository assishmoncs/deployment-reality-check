{
  "name": "deployment-reality-check",
  "version": "1.0.0",
  "description": "A deployment preflight CLI that detects production risks, explains platform-specific failures, and suggests safe fixes before you deploy.",
  "keywords": [
    "typescript",
    "cli",
    "developer-tools",
    "devops",
    "deployment",
    "static-analysis",
    "vercel",
    "railway",
    "nextjs",
    "nodejs",
    "production-readiness",
    "open-source"
  ],
  "homepage": "https://github.com/assishmoncs/deployment-reality-check#readme",
  "bugs": {
    "url": "https://github.com/assishmoncs/deployment-reality-check/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assishmoncs/deployment-reality-check.git"
  },
  "license": "MIT",
  "author": "Deployment Reality Check Contributors",
  "bin": {
    "drc": "./bin/run.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "typecheck": "node scripts/typecheck.cjs",
    "lint": "node scripts/lint.cjs",
    "format": "node scripts/format.cjs --write",
    "format:check": "node scripts/format.cjs --check",
    "test": "node scripts/test.cjs",
    "test:coverage": "node scripts/coverage.cjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "diff": "^5.2.0",
    "handlebars": "^4.7.8",
    "smol-toml": "^1.9.1",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/babel__traverse": "^7.20.5",
    "@types/diff": "^5.0.9",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  }
}
